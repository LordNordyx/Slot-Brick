#!/bin/sh
# Slot OS: the first and only program the kernel starts (PID 1). It loads the GPU driver,
# mounts the card and runs Slot, again and again, until Slot asks to power off or restart.
# Only this script and busybox live in RAM; the system's libraries, the GPU driver, Slot and
# the player's files are on the card (/lib and /usr point into its slot-os folder).
export PATH=/bin:/sbin:/usr/bin:/usr/sbin
export HOME=/root
export LD_LIBRARY_PATH=/usr/lib:/lib/aarch64-linux-gnu:/usr/lib/aarch64-linux-gnu
CARD=/mnt/SDCARD
ROOT=$CARD/Slot
DEV=/dev/mmcblk0p4

mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev
mkdir -p /dev/pts /dev/shm
mount -t devpts devpts /dev/pts
mount -t tmpfs -o mode=1777 tmpfs /tmp
mount -t tmpfs -o mode=755 tmpfs /run
exec < /dev/console > /dev/console 2>&1

# Uptime at each step, kept in /run until the card is there to hold it.
TIMES=/run/boot-times.log
stamp() { echo "$(cut -d' ' -f1 /proc/uptime) $*" >> "$TIMES"; }
stamp init started
# The kernel arms the hardware watchdog at boot (16 s): unless it is fed, the Brick resets,
# whatever it is writing to the card at the time. Fed every 5 s from here on, as Knulli does.
watchdog -T 16 -t 5 /dev/watchdog0 2>/dev/null || watchdog -t 5 /dev/watchdog
# How far startup got, for a Brick with no serial cable attached: a short buzz and blue
# LEDs once this script runs, green once the card is mounted; red and a long buzz when no
# card could be mounted. (u-boot showed the card's bootlogo.bmp before, if it got that far.)
LEDS=/sys/class/led_anim
leds() {
    [ -d "$LEDS" ] || return 0
    echo 1 > "$LEDS/effect_enable"
    for f in max_scale max_scale_f1f2 max_scale_lr; do echo 60 > "$LEDS/$f"; done
    for z in m f1 f2 lr; do
        echo "$1 " > "$LEDS/effect_rgb_hex_$z"; echo -1 > "$LEDS/effect_cycles_$z"
        echo 2000 > "$LEDS/effect_duration_$z"; echo 4 > "$LEDS/effect_$z"
    done 2>/dev/null
}
RUMBLE=/sys/class/gpio/gpio227
buzz() {
    [ -d "$RUMBLE" ] || echo 227 > /sys/class/gpio/export
    echo out > "$RUMBLE/direction" && echo 1 > "$RUMBLE/value" && sleep "$1"
    echo 0 > "$RUMBLE/value"
} 2>/dev/null
leds 0000FF
buzz 0.3

# The card: its fourth partition, FAT, holds Slot, the system's libraries (slot-os) and the
# player's files. It should be mmcblk0p4 (as for Knulli); failing that, the partition that
# holds slot-os. Each is looked at read-only first: the Brick's internal storage must never
# be written to.
mount_card() {
    mount -t vfat -o ro,noatime,utf8,shortname=mixed,errors=remount-ro "$1" "$CARD" 2>>/run/mount.log \
        || mount -t exfat -o ro,noatime "$1" "$CARD" 2>>/run/mount.log
}
n=0
while [ ! -b "$DEV" ] && [ "$n" -lt 500 ]; do sleep 0.01; n=$((n + 1)); done
mkdir -p "$CARD"
mounted=
for dev in "$DEV" $(ls /dev/mmcblk*p* 2>/dev/null); do
    [ -b "$dev" ] || continue
    if mount_card "$dev"; then
        if [ -d "$CARD/Slot" ] && [ -d "$CARD/slot-os" ] && mount -o remount,rw "$CARD"; then mounted=$dev; break; fi
        umount "$CARD"
    fi
done
if [ -n "$mounted" ]; then
    stamp "card mounted ($mounted)"
    leds 00FF00
else
    stamp "card NOT mounted: $(cat /run/mount.log)"
    leds FF0000
    buzz 1.5
    # Nothing more can run without the card: a shell on the serial port, for a UART cable.
    # (PID 1 must never end, or the kernel panics.)
    setsid sh -c 'exec sh </dev/ttyS0 >/dev/ttyS0 2>&1' &
    while :; do sleep 3600; done
fi

# The GPU driver (pvrsrvkm, dc_sunxi): pvrsrvctl loads both from here.
( cd /lib/modules/4.9.191 && pvrsrvctl --start ) > /run/gpu.log 2>&1
stamp GPU driver loaded

# A shell on the serial port (debug pads), for anyone with a UART adapter attached.
[ -c /dev/ttyS0 ] && setsid sh -c 'exec sh </dev/ttyS0 >/dev/ttyS0 2>&1' &

mkdir -p "$ROOT/Logs" 2>/dev/null
[ ! -f "$ROOT/Logs/boot-times.log" ] || mv -f "$ROOT/Logs/boot-times.log" "$ROOT/Logs/boot-times.previous.log"
cp "$TIMES" "$ROOT/Logs/boot-times.log" 2>/dev/null && TIMES="$ROOT/Logs/boot-times.log"
export SLOT_BOOT_TIMES="$TIMES"
{
    echo "Slot OS $(cat /etc/slot-os-version)"; uname -a
    echo '--- mount'; cat /run/mount.log; echo '--- gpu'; cat /run/gpu.log
    echo '--- kernel log'; dmesg
} > "$ROOT/Logs/os.log" 2>&1

export SLOT_ROOT="$ROOT"
export SLOT_OS=1
cleanup() { sync; umount "$CARD" 2>/dev/null || mount -o remount,ro "$CARD"; }
quick=0
while :; do
    if [ ! -x "$ROOT/System/slot" ]; then
        echo "Slot OS: $ROOT/System/slot is missing" | tee -a "$ROOT/Logs/os.log"
        sleep 30; cleanup; poweroff -f
    fi
    [ ! -f "$ROOT/Logs/slot.log" ] || mv -f "$ROOT/Logs/slot.log" "$ROOT/Logs/slot.previous.log"
    stamp starting slot
    started=$(cut -d. -f1 /proc/uptime)
    ( cd "$ROOT" && exec ./System/slot ) > "$ROOT/Logs/slot.log" 2>&1
    status=$?
    echo "slot exit code: $status" >> "$ROOT/Logs/slot.log"
    { echo "--- kernel log after slot ended ($status)"; dmesg | tail -40; } >> "$ROOT/Logs/os.log"
    sync
    case "$status" in
        64) cleanup; poweroff -f ;;
        65) cleanup; reboot -f ;;
        66) quick=0; continue ;;
    esac
    # Anything else (a crash, or the exit chord, with no stock menu to go back to): start
    # Slot again, keeping the crash log; three quick ends in a row and it powers off.
    if [ "$status" -ge 128 ]; then
        mkdir -p "$ROOT/Logs/crash" && cp "$ROOT/Logs/slot.log" "$ROOT/Logs/crash/slot-$(date '+%Y-%m-%d_%H-%M-%S').log"
    fi
    if [ $(( $(cut -d. -f1 /proc/uptime) - started )) -lt 10 ]; then quick=$((quick + 1)); else quick=0; fi
    [ "$quick" -lt 3 ] || { echo 'Slot OS: Slot keeps ending; powering off' >> "$ROOT/Logs/os.log"; cleanup; poweroff -f; }
    sleep 1
done
