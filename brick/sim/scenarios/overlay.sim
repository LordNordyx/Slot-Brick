# An overlay chosen on the Game Boy page goes over Pocket Test, the game fitted into its window,
# and L1/R1 can no longer change the picture's size while it is on. Home+R1 steps it in game.
press a
phase Shelf
press menu
phase QuickMenu
press a       # Screen
press a       # Game Boy / GBC
press down
press down
press down    # GB Overlay
press right
snap menu-overlay
# A name too long for its row: lit, it starts at its start and scrolls along; not lit, it is
# cut short with dots.
press b
press down    # Game Boy Advance
press a
press down
press down    # Overlay
press right
snap menu-overlay-long
wait 4000
grab menu-overlay-long-scrolled
press up
snap menu-overlay-long-dim
press b
press up
press b
press b
press b
press b
phase Shelf
press r1     # GBA -> GB
press a
phase Playing 20000
wait 1000
snap game-overlay
press l1
wait 600
snap game-overlay-l1
# Home+R1 in game: the next overlay, which after the only one there is, is Off; then back on.
down menu
press r1
up menu
wait 600
snap game-overlay-off
down menu
press r1
up menu
wait 600
snap game-overlay-back
hold menu 1500   # save state, eject, back to the shelf
phase Shelf 20000
